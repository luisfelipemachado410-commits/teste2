            z-index: 5;
            animation-delay: 400ms;
        }

        @keyframes reveal {
            from {
                opacity: 0;
                transform: translateY(18px) scale(.94);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .layer {
                animation: none;
                transition: none;
            }
        }
    </style>
