<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>5 Camadas</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #f0f0f0;
        }

        .container {
            position: relative;
            width: 500px;
            height: 500px;
        }

        .layer {
            position: absolute;
            width: 300px;
            height: 300px;
            border: 2px solid #000;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
            color: white;
        }

        .layer1 {
            background: red;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .layer2 {
            background: red;
            top: 30px;
            left: 30px;
            z-index: 2;
        }

        .layer3 {
            background: green;
            top: 60px;
            left: 60px;
            z-index: 3;
        }

        .layer4 {
            background: orange;
            top: 90px;
            left: 90px;
            z-index: 4;
        }

        .layer5 {
            background: purple;
            top: 120px;
            left: 120px;
            z-index: 5;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="layer layer1">Camada 1</div>
        <div class="layer layer2">Camada 2</div>
        <div class="layer layer3">Camada 3</div>
        <div class="layer layer4">Camada 4</div>
        <div class="layer layer5">Camada 5</div>
    </div>

</body>
</html>
