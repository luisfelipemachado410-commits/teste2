<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>5 Camadas</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: "Trebuchet MS", sans-serif;
            background: linear-gradient(135deg, #071a2b, #164e63 55%, #22d3ee);
        }

        .container {
            position: relative;
            width: min(88vw, 500px);
            aspect-ratio: 1;
            filter: drop-shadow(0 24px 28px rgb(0 0 0 / 35%));
        }

        .layer {
            position: absolute;
            width: 60%;
            height: 60%;
            border: 2px solid rgb(255 255 255 / 65%);
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: clamp(14px, 3.5vw, 24px);
            font-weight: bold;
            color: white;
            text-shadow: 0 2px 3px rgb(0 0 0 / 30%);
            box-shadow: inset 0 1px rgb(255 255 255 / 35%), 0 8px 16px rgb(0 0 0 / 18%);
            animation: reveal 700ms both;
            transition: transform 180ms ease, filter 180ms ease;
        }

        .layer:hover {
            transform: translate(-5px, -5px) scale(1.02);
            filter: brightness(1.12);
        }

        .layer1 {
            background: #ef4444;
            top: 0;
            left: 0;
            z-index: 1;
            animation-delay: 80ms;
        }

